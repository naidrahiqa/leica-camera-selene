//
// Leica Camera 5.0 untuk selene / MT6768 — prebuilt kamera.
//
// PERINGATAN
// ----------
// Patch di MiuiCamera.apk MEMATIKAN hardware MFNR (MFB) dan menyalakan software
// MFNR. Benar untuk MT6768/MT6769 yang tidak punya blok MFB sama sekali
// (0 port M4U, 0 event MFB). Tanpa patch, Night mode dan foto zoom 1.0X timeout
// dengan "wait task result failed:-110" (ETIMEDOUT) lalu onCameraAbnormal.
//
// JANGAN dipindah ke chipset ber-MFB (mt6779, mt6873, mt6853, mt6781, mt6833,
// mt6885) — di sana hardware MFNR berguna dan software MFNR jauh lebih buruk.
//
// Regenerasi APK setelah upgrade versi kamera:
//     tools/patch-night.sh <MiuiCamera-apk-asli>
//
// SIGNING
// -------
// Default: certificate "platform".
//   Kamera meminta 9 privileged permission (SYSTEM_CAMERA, WRITE_SECURE_SETTINGS,
//   WRITE_MEDIA_STORAGE, ...). Kalau_signed platform, Android otomatis memberi
//   hak priv-app tanpa perlu allowlist.
//
// Fallback: kalau kameraMIUI menolak / crash karena signature, ubah
// `certificate:` menjadi `// certificate:` (dikomentari) supaya signature asli
// dipertahankan, lalu andalkan allowlist
// permissions/privapp-permissions-miuicamera.xml yang tetap ikut terpasang.
// Verified path di modul = signature debug + allowlist, jadi fallback ini
// sudah terbukti bekerja.
//

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app_import {
    name: "MiuiCamera.apk",
    apk: "MiuiCamera.apk",
    certificate: "platform",
    product: "system",
    privileged: true,
    installable: true,
    // .so diletakkan manual di system/priv-app/MiuiCamera/lib/arm64/ oleh
    // camera.mk (PRODUCT_COPY_FILES) — pola yang sama dengan modul KernelSU.
    // extractNativeLibs=true supaya platform memuat .so dari sana.
    extract_native_libs: true,
}

android_app_import {
    name: "MiuiExtraPhoto.apk",
    apk: "MiuiExtraPhoto.apk",
    certificate: "platform",
    product: "system",
    privileged: true,
    installable: true,
    extract_native_libs: true,
}

android_app_import {
    name: "MiuiScanner.apk",
    apk: "MiuiScanner.apk",
    certificate: "platform",
    product: "system",
    privileged: true,
    installable: true,
    extract_native_libs: true,
}