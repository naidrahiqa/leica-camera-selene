#
# Leica Camera - SELinux rules
#
# Diterjemahkan dari sepolicy.rule modul KernelSU (format magiskpolicy/ksud)
# ke bentuk .te yang valid untuk device/mediatek/sepolicy_vndr.
#
# ---------------------------------------------------------------------------
# PERINGATAN - baca sebelum menyalakan
# ---------------------------------------------------------------------------
# Aturan ini berasal dari modul Magix yang berjalan di ROM BERBEDA (Lineage /
# Project Infinity) dengan vendor policy yang berbeda. Sebagian besar rule-nya
# sudah ada di platform/mediatek. Menyalin mentah bisa:
#   - gagal build ("duplicate declaration" / "neverallow violated"), atau
#   - memunculkan avc: denied yang lebih sulit ditelusuri.
#
# Karena itu berkas ini sengaja dibuat MINIMAL: hanya rule yang benar-benar
# dibutuhkan kamera Leica. Kalau kamera sudah jalan tanpa rule tambahan apa pun
# (kemungkinan besar, karena vendor policy MTK sudah lengkap), semua rule di
# sini bisa dihapus satu per satu.
#
# Cara memverifikasi:
#   1. Build ROM dengan sepolicy ini.
#   2. Boot, buka kamera, coba Night dan zoom 1.0X.
#   3. Kalau bersih, tidak ada yang perlu diubah.
#   4. Kalau tidak, pasang modul KernelSU (jalur yang sudah terbukti working)
#      sementara, lalu lihat lewat logcat rule mana yang benar-benar dipakai:
#         adb logcat -b all | grep -i avc
#
# Status: BELUM teruji di device. Menyalaan semuanya tanpa uji berisiko.
# ---------------------------------------------------------------------------

# --- camera HAL -----------------------------------------------------------
# HAL kamera butuh graphic allocator untuk membuat buffer.
allow hal_camera_default hal_graphics_allocator_default binder call
allow hal_camera_default hal_graphics_allocator_hwservice hwservice_manager find

# Launcher film LEICA menampilkan efek yang butuh surfaceflinger configstore.
allow hal_camera_default hal_configstore_default binder call
allow hal_camera_default hal_configstore_ISurfaceFlingerConfigs hwservice_manager find

# --- cameraserver ---------------------------------------------------------
# Kamera menulis properti vendor seperti vendor.sys.camerainfo.
allow cameraserver vendor_default_prop property_service set
allow cameraserver vendor_file dir { open read }

# CameraServer perlu connect ke init untuk membuat socket.
allow cameraserver init unix_stream_socket connectto

# --- platform_app ---------------------------------------------------------
# Platform app (termasuk kamera yang dijalankan sebagai priv-app) membaca
# vendor_default_prop.
allow platform_app vendor_default_prop file { getattr open read }

# --- priv_app -------------------------------------------------------------
# Priv app butuh eksekusi vendor_file untuk memanggil library algoritma Leica
# (libSNPE, libsymphony-cpu, MNN, dan sejenisnya).
allow priv_app vendor_file file { execute getattr open read map }

# Priv app membaca vendor audio prop (untuk fitur video/audio).
allow priv_app vendor_audio_prop file { getattr }

# Priv app membaca cgroup (dipakai power hint).
allow priv_app cgroup file { open read }

# --- mediaserver ----------------------------------------------------------
allow mediaserver vendor_file dir { open read }

# --- system_server --------------------------------------------------------
allow system_server vendor_default_prop file { getattr open read }