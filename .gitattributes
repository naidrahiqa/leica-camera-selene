# Normalise text files and force LF.
* text=auto

# Binaries are tracked with Git LFS. The camera APK alone is ~169 MB and the
# 47 native libraries add up to another ~124 MB, which is far past what a
# regular git object store should be carrying.
*.apk filter=lfs diff=lfs merge=lfs -text
*.so   filter=lfs diff=lfs merge=lfs -text
*.jar  filter=lfs diff=lfs merge=lfs -text

# Explicit entries, so these paths stay LFS-tracked even if a glob above is
# reordered or removed later.
proprietary/system/priv-app/MiuiCameraLeica/MiuiCameraLeica.apk filter=lfs diff=lfs merge=lfs -text
proprietary/system/priv-app/MiuiExtraPhoto/MiuiExtraPhoto.apk filter=lfs diff=lfs merge=lfs -text
proprietary/system/priv-app/MiuiScanner/MiuiScanner.apk filter=lfs diff=lfs merge=lfs -text